{
  "name": "aurora-swapper",
  "version": "0.1.1",
  "productName": "Aurora Swapper",
  "description": "Install, repair, and restore OptiScaler Aurora for games in a local library.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:aurora",
    "test:legacy": "node --test --test-concurrency=1 test/*.test.js",
    "test:aurora": "node scripts/test-aurora.js",
    "test:ui": "electron scripts/test-game-filters-ui.js",
    "test:payload": "node scripts/test-feeder-payload.js",
    "test:optiscaler": "node scripts/test-optiscaler-payload.js",
    "payload": "node scripts/collect-payload.js",
    "prebuild": "npm run payload",
    "build": "electron-builder --win",
    "build:linux": "electron-builder --linux AppImage deb",
    "icon": "electron scripts/make-icon.js",
    "build:portable": "electron-builder --win portable",
    "overlay:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-overlay.ps1",
    "overlay:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-overlay.ps1"
  },
  "author": "spikejulia; interface based on DLSS 5 Swapper by Rakan Alkhaldi",
  "license": "MIT",
  "homepage": "https://github.com/SpikeJulia/Aurora-Swapper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpikeJulia/Aurora-Swapper.git"
  },
  "bugs": {
    "url": "https://github.com/SpikeJulia/Aurora-Swapper/issues"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "7zip-bin": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.aurora.swapper",
    "productName": "Aurora Swapper",
    "files": [
      "main.js",
      "preload.js",
      "overlay-preload.js",
      "THIRD_PARTY_NOTICES.md",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "spikejulia",
      "icon": "assets/logo.png",
      "artifactName": "Aurora-Swapper-${version}-${arch}.${ext}"
    },
    "compression": "maximum",
    "portable": {
      "artifactName": "Aurora-Swapper-${version}-portable.exe",
      "unpackDirName": "Aurora-Swapper"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Aurora Swapper",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Aurora-Swapper-Setup-${version}.exe",
      "include": "build/installer.nsh"
    }
  }
}
